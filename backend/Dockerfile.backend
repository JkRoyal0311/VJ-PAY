# Stage 1: Build the application
FROM maven:3.9.6-eclipse-temurin-17 AS build
WORKDIR /app

# Copy the pom.xml and source code
COPY pom.xml .
COPY src ./src

# Package the application (skip tests for faster deployment builds)
RUN mvn clean package -DskipTests

# Stage 2: Run the application
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

# Copy the built file from the build stage (Spring Boot is creating a .war file)
COPY --from=build /app/target/*.war app.jar

# Expose port 8080
EXPOSE 8080

# Startup script: Convert Render's DATABASE_URL (postgres://user:pass@host/db)
# to Spring Boot's JDBC format (jdbc:postgresql://host/db) and set credentials
COPY <<'EOF' /app/start.sh
#!/bin/sh
if [ -n "$DATABASE_URL" ]; then
  # Extract components from DATABASE_URL
  SPRING_DATASOURCE_URL="jdbc:postgresql://$(echo $DATABASE_URL | sed -E 's|^postgres(ql)?://[^@]+@||')"
  SPRING_DATASOURCE_USERNAME="$(echo $DATABASE_URL | sed -E 's|^postgres(ql)?://([^:]+):.*|\2|')"
  SPRING_DATASOURCE_PASSWORD="$(echo $DATABASE_URL | sed -E 's|^postgres(ql)?://[^:]+:([^@]+)@.*|\2|')"
  export SPRING_DATASOURCE_URL SPRING_DATASOURCE_USERNAME SPRING_DATASOURCE_PASSWORD
fi
exec java -jar app.jar
EOF
RUN chmod +x /app/start.sh

# Command to run the application
ENTRYPOINT ["/app/start.sh"]

